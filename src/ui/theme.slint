// Paleta del frontend: vidrio sobre un degradado oscuro con halos de color.
export global Theme {
    out property <color> fondo-arriba: #241354;
    out property <color> fondo-abajo: #07060f;
    out property <color> violeta: #8b5cf6;
    out property <color> cian: #22d3ee;
    out property <color> rosa: #f472b6;
    out property <color> vidrio: #ffffff12;
    out property <color> vidrio-fuerte: #ffffff1c;
    out property <color> vidrio-hover: #ffffff2e;
    out property <color> borde: #ffffff26;
    out property <color> borde-fuerte: #ffffff3d;
    out property <color> texto: #f6f5ff;
    out property <color> texto-tenue: #b3b6d4;
    out property <color> ok: #4ade80;
    out property <color> alerta: #fbbf24;
    out property <color> error: #fb7185;
    out property <length> radio: 24px;
    out property <string> mono: "monospace";
}
